# --- UCF for HC-IoT-DSC Final Implementation ---
# Target Device: XC6SLX9 TQG144C Spartan-6 FPGA

# 1. Clock Constraint: 50 MHz Oscillator
# Pin P84 is the confirmed clock input.
NET "clk_50mhz" LOC = "P84" | IOSTANDARD = LVCMOS33;

# 2. Reset Constraint: Active-low Reset
# Pin P11 (Slide Switch SW10) is used for the system reset.
NET "rst_n"       LOC = "P11" | IOSTANDARD = LVCMOS33;

# 3. UART Output Constraint: TXD to USB-UART Bridge
# Pin P116 is the confirmed output pin for the USB UART bridge (TXD).
NET "uart_tx_pin" LOC = "P116" | IOSTANDARD = LVCMOS33 | DRIVE = 8;

# 4. LED Output Constraint: LED D2 Status
# Pin P33 is connected to LED D2 (Logic HIGH turns LED ON).
NET "led_cipher_ready" LOC = "P32" | IOSTANDARD = LVCMOS33 | DRIVE = 8;

# 5. Plaintext Valid Input Constraint
# Pin P45 is used for the push button SW14, serving as the pt_valid_in trigger.
NET "pt_valid_in" LOC = "P43" | IOSTANDARD = LVCMOS33;

# --- Placeholder Constraint for Plaintext Data Input ---
# The 64-bit plaintext_in bus must be physically connected or internally driven.
# This placeholder assumes the bus will be driven by internal constants/registers for testing.
# For full external data input, all 64 pins must be individually constrained.
# NET "plaintext_in<0>" LOC = "P..." | IOSTANDARD = LVCMOS33;
# ...